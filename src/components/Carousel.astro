---
const tech = [
  "/carousel/prisma.svg",
  "/carousel/drizzle.svg",
  "/carousel/contentful.svg",
  "/carousel/docker.svg",
  "/carousel/express.svg",
  "/carousel/nestjs.svg",
  "/carousel/javascript.svg",
  "/carousel/stripe.svg",
  "/carousel/astro.svg",
  "/carousel/typescript.svg",
  "/carousel/react.svg",
  "/carousel/nextdotjs.svg",
  "/carousel/remix.svg",
  "/carousel/vite.svg",
  "/carousel/tailwindcss.svg",
  "/carousel/reactquery.svg",
  "/carousel/reactrouter.svg",
  "/carousel/reacthookform.svg",
  "/carousel/zod.svg",
  "/carousel/postgresql.svg",
  "/carousel/mongodb.svg",
  "/carousel/serverless.svg",
  "/carousel/sst.svg",
];
---

<section class="relative w-screen left-1/2 right-1/2 -mx-[50vw] mt-20">
  <div class="overflow-hidden border-y border-neutral-200 bg-white/80 py-10">
    <div class="marquee">
      {/* set A */}
      <div class="marquee-track">
        {
          tech.map((src) => (
            <img src={src} alt={src} class="size-14 shrink-0" loading="lazy" />
          ))
        }
      </div>

      {/* set B */}
      <div class="marquee-track" aria-hidden="true">
        {
          tech.map((src) => (
            <img src={src} alt={src} class="size-14 shrink-0" loading="lazy" />
          ))
        }
      </div>
    </div>
  </div>
</section>
