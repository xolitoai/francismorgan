---
import ContactModal from "./react/contact-modal";
import Link from "./ui/Link.astro";
---

<section class="mt-32 sm:mt-40 text-center">
  <div class="rounded-xl bg-white/90 p-8 sm:p-10 shadow">
    <h2
      class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900"
    >
      ¿Tienes un proyecto en mente?
    </h2>

    <p class="mt-4 text-neutral-500">
      Conversemos y definamos la mejor solución para tu negocio.
    </p>

    <div class="mt-8">
      <!-- <Link variant="primary">Contáctanos</Link> -->
      <ContactModal client:load />
    </div>
  </div>
</section>
