---
import Link from "./ui/Link.astro";
---

<section class="text-center">
  <h1
    class="mx-auto max-w-6xl text-balance lg:leading-18 text-4xl sm:text-5xl md:text-6xl font-black tracking-tighter text-neutral-900"
  >
    Soluciones digitales a tu medida
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg text-neutral-500">
    Diseñamos y desarrollamos software confiable con enfoque en calidad y
    resultados.
  </p>

  <div
    class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-6"
  >
    <Link variant="primary">Contáctanos</Link>

    <Link variant="secondary">Conocer más</Link>
  </div>
</section>
