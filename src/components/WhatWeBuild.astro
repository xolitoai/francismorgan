---
import { Globe, LayoutDashboard, Wrench } from "@lucide/astro";
import Card from "./ui/Card.astro";
import Title from "./ui/Title.astro";
---

<section class="mt-24 sm:mt-32">
  <Title>Qué construimos</Title>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
    <Card
      variant="bordered"
      icon={Globe}
      title="Sitios web para negocios"
      content="Páginas profesionales, rápidas y enfocadas en comunicar valor."
    />

    <Card
      variant="bordered"
      icon={LayoutDashboard}
      title="Aplicaciones web a la medida"
      content="Sistemas diseñados según los procesos de tu empresa."
    />

    <div class="sm:col-span-2">
      <Card
        variant="bordered"
        icon={Wrench}
        title="Herramientas internas y automatización"
        content="Soluciones para reducir trabajo manual y mejorar eficiencia."
      />
    </div>
  </div>
</section>
