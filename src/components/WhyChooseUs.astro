---
import { Cpu, LifeBuoy, Puzzle, Users } from "@lucide/astro";
import Card from "./ui/Card.astro";
import Title from "./ui/Title.astro";
---

<section class="mt-24 sm:mt-32">
  <Title>Por qué elegirnos</Title>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-10">
    <Card
      icon={Puzzle}
      title="Desarrollo a la medida"
      content="No usamos plantillas ni soluciones genericas."
    />
    <Card
      icon={Users}
      title="Trato directo"
      content="Comunicación clara y sin intermediarios."
    />
    <Card
      icon={Cpu}
      title="Tecnología moderna"
      content="Herramientas actuales, seguras y escalables."
    />
    <Card
      icon={LifeBuoy}
      title="Soporte y continuidad"
      content="Acompañamiento después de la entrega si lo necesitas."
    />
  </div>
</section>
