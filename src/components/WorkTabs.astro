---
import { ArrowRight, Minus } from "@lucide/astro";
import Title from "./ui/Title.astro";

const projects = [
  {
    id: "xolito",
    title: "Xolito",
    description:
      "Plataforma de finanzas personales vía WhatsApp con dashboard web.",
    highlights: [
      "Procesamiento de lenguaje natural",
      "Integración con WhatsApp",
      "Arquitectura serverless",
    ],
  },
  {
    id: "agentic",
    title: "Agentic pipelines",
    description:
      "Automatización inteligente para clasificar, extraer y validar documentos.",
    highlights: [
      "Pipelines multi-step",
      "Validación automática",
      "Reducción de trabajo manual",
    ],
  },
  {
    id: "postgres-search",
    title: "Búsqueda con PostgreSQL",
    description:
      "Búsqueda avanzada de alto rendimiento sin servicios externos.",
    highlights: [
      "Full-text search",
      "Respuestas en milisegundos",
      "Optimización SQL",
    ],
  },
];
---

<section class="mt-24 sm:mt-32" data-work-tabs>
  <Title>Proyectos</Title>

  <div
    class="mt-10 p-8 sm:p-10 rounded-xl bg-white/90 shadow grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-10"
  >
    <!-- Tabs (left) -->
    <nav class="space-y-2" role="tablist" aria-label="Proyectos">
      {
        projects.map((project, idx) => (
          <button
            type="button"
            role="tab"
            tabindex={idx === 0 ? "0" : "-1"}
            aria-selected={idx === 0 ? "true" : "false"}
            class="work-tab block w-full text-left text-sm px-3 py-2 rounded-xl text-neutral-900 outline-none cursor-pointer data-[active=true]:text-indigo-600 data-[active=true]:bg-indigo-600/5"
            data-target={project.id}
            data-active={idx === 0 ? "true" : "false"}
          >
            {project.title}
          </button>
        ))
      }
    </nav>

    <!-- Content (right) -->
    <div>
      {
        projects.map((project, idx) => (
          <div
            class="work-panel"
            data-panel={project.id}
            style={idx === 0 ? "" : "display:none"}
          >
            <h3 class="text-2xl font-semibold tracking-tight text-neutral-900">
              {project.title}
            </h3>

            <p class="mt-4 max-w-prose text-neutral-700">
              {project.description}
            </p>

            <ul class="mt-6 space-y-2 text-sm ">
              {project.highlights.map((item) => (
                <li class="flex items-center gap-2">
                  <Minus class="text-indigo-600 size-3.5" />
                  <span class="text-neutral-700">{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <a
                href="/work"
                class="inline-flex items-center gap-2 text-sm font-medium"
              >
                <span class="text-indigo-600 hover:text-indigo-500">
                  Ver más
                </span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-work-tabs]");
      if (!root) return;

      const tabs = Array.from(root.querySelectorAll(".work-tab"));
      const panels = Array.from(root.querySelectorAll(".work-panel"));

      const setActive = (id, focus = true) => {
        tabs.forEach((btn) => {
          const active = btn.dataset.target === id;
          btn.dataset.active = active ? "true" : "false";
          btn.setAttribute("aria-selected", active ? "true" : "false");
          btn.setAttribute("tabindex", active ? "0" : "-1");
          if (active && focus) btn.focus();
        });

        panels.forEach((panel) => {
          panel.style.display = panel.dataset.panel === id ? "" : "none";
        });
      };

      tabs.forEach((btn, index) => {
        btn.addEventListener("click", () => setActive(btn.dataset.target));

        btn.addEventListener("keydown", (e) => {
          let next = index;

          if (e.key === "ArrowDown" || e.key === "ArrowRight") next++;
          if (e.key === "ArrowUp" || e.key === "ArrowLeft") next--;
          if (e.key === "Home") next = 0;
          if (e.key === "End") next = tabs.length - 1;

          if (next !== index) {
            e.preventDefault();
            const target = tabs[(next + tabs.length) % tabs.length];
            setActive(target.dataset.target);
          }
        });
      });
    })();
  </script>
</section>
