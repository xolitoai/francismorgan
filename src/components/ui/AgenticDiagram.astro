<svg
  viewBox="0 0 800 520"
  class="w-full max-w-3xl mx-auto"
  xmlns="http://www.w3.org/2000/svg"
>
  <style>
    .box {
      fill: #fff;
      stroke: #e5e7eb;
      stroke-width: 2;
      rx: 12;
    }
    .agent {
      stroke: #6366f1;
    }
    .text {
      fill: #111827;
      font-size: 14px;
      font-family: system-ui;
    }
    .arrow {
      stroke: #9ca3af;
      stroke-width: 2;
      marker-end: url(#arrow);
    }
  </style>

  <defs>
    <marker
      id="arrow"
      viewBox="0 0 10 10"
      refX="5"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#9ca3af"></path>
    </marker>
  </defs>

  <!-- Boxes -->
  <rect x="40" y="40" width="240" height="48" class="box"></rect>
  <text x="160" y="70" text-anchor="middle" class="text">Ingestión</text>

  <rect x="40" y="110" width="240" height="48" class="box"></rect>
  <text x="160" y="140" text-anchor="middle" class="text">OCR</text>

  <rect x="40" y="180" width="240" height="48" class="box"></rect>
  <text x="160" y="210" text-anchor="middle" class="text">Layout y orden</text>

  <rect x="40" y="250" width="240" height="48" class="box"></rect>
  <text x="160" y="280" text-anchor="middle" class="text">Comprensión</text>

  <rect x="360" y="180" width="300" height="72" class="box agent"></rect>
  <text x="510" y="215" text-anchor="middle" class="text">
    Extracción agentic
  </text>

  <rect x="360" y="300" width="300" height="48" class="box"></rect>
  <text x="510" y="330" text-anchor="middle" class="text">
    Salida estructurada
  </text>

  <rect x="360" y="370" width="300" height="48" class="box"></rect>
  <text x="510" y="400" text-anchor="middle" class="text">
    Artefactos RAG
  </text>

  <!-- Arrows -->
  <line x1="160" y1="88" x2="160" y2="110" class="arrow"></line>
  <line x1="160" y1="158" x2="160" y2="180" class="arrow"></line>
  <line x1="160" y1="228" x2="160" y2="250" class="arrow"></line>
  <line x1="280" y1="274" x2="360" y2="216" class="arrow"></line>
  <line x1="510" y1="252" x2="510" y2="300" class="arrow"></line>
  <line x1="510" y1="348" x2="510" y2="370" class="arrow"></line>

  <!-- Agentic loop -->
  <path d="M 660 216 C 720 216 720 140 510 140" fill="none" class="arrow"
  ></path>
</svg>
