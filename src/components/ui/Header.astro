---
import Image from "astro/components/Image.astro";
import ContactModal from "../react/contact-modal";
---

<header
  class="fixed flex z-50 justify-center items-center inset-x-0 h-16 border-b border-neutral-200 bg-white/90 backdrop-blur"
>
  <div
    class="mx-auto max-w-6xl w-full px-6 h-16 flex items-center justify-between"
  >
    <!-- Brand -->
    <a href="/" class="text-lg font-bold tracking-tighter text-neutral-900">
      <Image
        alt="logo"
        src={{
          src: "/brand/francismorgan-full.svg",
          height: 200,
          width: 200,
          format: "svg",
        }}
      />
    </a>

    <!-- Navigation + CTA -->
    <div class="flex items-center gap-6">
      <nav class="hidden sm:flex items-center gap-3">
        <!-- <a href="#que-construimos" class="text-neutral-900 text-sm transition">
          Servicios
        </a>
        <a href="#como-trabajamos" class="text-neutral-900 text-sm transition">
          Proceso
        </a>
        <a href="#porque-elegirnos" class="text-neutral-900 text-sm transition">
          Nosotros
        </a> -->
        <a href="/work" class="text-neutral-900 text-sm transition">
          Trabajo
        </a>
      </nav>

      <div class="hidden sm:block">
        <ContactModal client:load size="small" />
      </div>
    </div>
  </div>
</header>
