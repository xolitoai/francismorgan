---
type Props = {
  title: string;
  description: string;
  highlights?: string[];
  href?: string;
};

const { title, description, highlights = [], href } = Astro.props as Props;
---

<article class="rounded-xl border border-neutral-200 bg-white/90 p-6">
  <h3 class="text-lg font-semibold text-neutral-900">
    {title}
  </h3>

  <p class="mt-2 text-neutral-700">
    {description}
  </p>

  {
    highlights.length > 0 && (
      <ul class="mt-4 space-y-1 text-sm text-neutral-600">
        {highlights.map((item) => (
          <li>• {item}</li>
        ))}
      </ul>
    )
  }

  {
    href && (
      <div class="mt-4">
        <a
          class="text-sm font-medium text-indigo-600 hover:text-indigo-500"
          href={href}
        >
          Ver proyecto →
        </a>
      </div>
    )
  }
</article>
