---
type Props = {
  layout?: "fit" | "normal";
};

import clsx from "clsx";
import Header from "../components/ui/Header.astro";
import "../styles/global.css";

const { layout = "fit" } = Astro.props;

const layoutClasses = clsx({
  "px-6 py-36 sm:py-40 max-w-3xl mx-auto": layout === "fit",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />
    <title>francis morgan</title>
  </head>

  <body>
    <div
      class="block fixed inset-0 -z-10 bg-[repeating-linear-gradient(315deg,rgba(79,70,229,0.035)_0,rgba(79,70,229,0.035)_1px,transparent_0,transparent_50%)] bg-size-[12px_12px]"
    >
    </div>
    <Header />
    <main class={layoutClasses}>
      <slot />
    </main>
  </body>
</html>
