import HowDoWeWork from "../components/HowDoWeWork.astro";
import Hero from "../components/Hero.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Cta from "../components/Cta.astro";
---

<Layout>
  <main class="px-6 py-20 sm:py-24 max-w-3xl mx-auto">
    <!-- hero -->
    <Hero />

    <!-- what do we build -->
    <WhatWeBuild />

    <!-- how do we work -->
    <HowDoWeWork />

    <!-- why choose us -->
