---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="px-6 py-24 max-w-3xl mx-auto">
    <h1 class="text-4xl font-black tracking-tight">
      Desarrollo web a la medida
    </h1>

    <p class="mt-4 text-lg text-gray-600">
      Sitios web, aplicaciones web y herramientas internas hechas
      específicamente para tu negocio.
    </p>

    <a class="inline-block mt-8 bg-black text-white px-6 py-3 rounded">
      Contáctanos
    </a>
  </main>
</Layout>
